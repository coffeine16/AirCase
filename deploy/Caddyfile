# TLS via DuckDNS: a free subdomain (ours: see deploy/README.md) pointed at the
# static IP. Telegram requires valid HTTPS for webhooks; Let's Encrypt issues the
# cert through the plain HTTP-01 challenge on port 80 — no DNS plugin and no
# DuckDNS token ever touches the VM. Because the IP is STATIC, DuckDNS is set
# once; the updater cron that dynamic-IP tutorials add is unnecessary here.
#
# Why DuckDNS over sslip.io: duckdns.org is on the Public Suffix List, so every
# subdomain gets its OWN Let's Encrypt rate-limit bucket. sslip.io is one shared
# domain that routinely exhausts LE limits and stalls issuance.
{$N8N_DOMAIN} {
    # The AirCase serving API shares this host under /aircase/*. One box, one
    # cert, one DuckDNS record — a second subdomain would mean a second LE
    # issuance and another thing to be wrong on stage.
    #
    # NOT /api/*. That was the first attempt and it silently broke n8n: n8n
    # serves its OWN REST API at /api/v1/*, so the proxy swallowed every n8n API
    # call and handed it to this container, which 404'd it. The n8n EDITOR kept
    # working — it is served from / — so a smoke test of the root page passes
    # while the API is dead underneath. Anything driving n8n over its API (the
    # MCP integration, workflow import/export, activation) fails with a bare
    # 404 and no clue why. Pick a prefix the upstream does not already own.
    #
    # handle_path (not handle) STRIPS the prefix, so the frontend's
    # NEXT_PUBLIC_API_URL=https://<host>/aircase reaches the app as /hotspots,
    # and main.py's routes need no prefix awareness. Ordering matters: this
    # block is matched before the catch-all below, so n8n keeps every other
    # path — /webhook/* and /api/v1/* included.
    handle_path /aircase/* {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy n8n:5678
    }
}
